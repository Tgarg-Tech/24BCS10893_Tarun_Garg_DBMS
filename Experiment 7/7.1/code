/* Implement a PL/SQL block with a cursor to fetch and display the Name and Salary of the top 5 highest-paid employees from the Staff table. */

--
CREATE TABLE Staff (
    Staff_ID NUMBER PRIMARY KEY,
    Name VARCHAR2(100),
    Salary NUMBER(10,2),
    Department VARCHAR2(50)
);

